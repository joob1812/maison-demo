# Copiez ce fichier sous le nom .env.local, puis renseignez les valeurs.

# Numéro WhatsApp qui reçoit les commandes :
# le vôtre pour une démonstration, celui du commerçant en production.
# Formats acceptés : 771234567, 77 123 45 67, +221771234567
NEXT_PUBLIC_WHATSAPP_BOUTIQUE=

# Adresse publique du site une fois en ligne (sitemap et référencement Google), ex. https://maison-demo.sn
NEXT_PUBLIC_SITE_URL=
